{
  "name": "agent-team-reporting",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned local tooling for Agent Team Allure reports.",
  "scripts": {
    "allure:generate": "allure generate allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "allure:agent": "allure agent inspect allure-results --output allure-agent-report",
    "allure:quality": "allure quality-gate allure-results"
  },
  "devDependencies": {
    "allure": "3.16.0"
  }
}
